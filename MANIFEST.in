include LICENSE
include README.md
include pyproject.toml

graft src
graft docs

prune tests
prune examples
prune .github
prune .idea
prune .vscode
prune .venv
prune .tools
prune .draw
prune .documentation
prune .package-check
prune data
prune research
prune notebooks
prune plots
prune reports
prune debug
prune exports
prune dist
prune build
prune htmlcov

global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.pyo
global-exclude *.pyd
global-exclude *.egg-info
global-exclude .pytest_cache
global-exclude .mypy_cache
global-exclude .ruff_cache
global-exclude .coverage
global-exclude .coverage.*
global-exclude coverage.xml
global-exclude *.sqlite3
global-exclude *.log
global-exclude *.tmp
global-exclude *.bak
global-exclude *.exe
global-exclude *.dll
global-exclude *.so
global-exclude *.dylib
global-exclude *.bin
